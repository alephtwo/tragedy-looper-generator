{
  "include": ["src"],
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["dom", "esnext"],
    "target": "es2024",

    // Build
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // JSX
    "jsx": "react-jsx"
  }
}
