{
  "include": ["src", "vite.config.mts"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],

    // Module Resolution
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@i18n/messages": ["./src/paraglide/messages"],
      "@/*": ["./src/*"]
    },

    // Build
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  }
}
