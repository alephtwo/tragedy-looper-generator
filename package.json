  "main": "dist/index.js",
  "scripts": {
    "start": "vite",
    "test": "vitest run",
    "coverage": "pnpm test -- --coverage",
    "mutate": "stryker run",
    "preview": "vite preview",
    "build": "vite build && pnpm typecheck",
    "typecheck": "tsc",
    "oxfmt": "oxfmt --check .",
    "format": "oxfmt --write .",
    "lint": "pnpm lint:ts && pnpm oxfmt && pnpm lint:md",
    "lint:ts": "oxlint .",
    "lint:md": "markdownlint-cli2 .",
    "build:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@tabler/icons-react": "3.48.0",
    "immer": "11.1.18",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/react": "4.13.0",
    "@inlang/cli": "3.3.8",
    "@inlang/paraglide-js": "2.25.4",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tailwindcss": "1.14.0",
    "oxlint-tsgolint": "7.0.2003",
    "radash": "12.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
